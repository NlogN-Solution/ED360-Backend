# Copy to .env and fill in real values. Never commit the real .env file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ignition
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
UPLOAD_DIR=

JWT_SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fernet key encrypting third-party credentials (e.g. WhatsApp access tokens) at
# rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Meta WhatsApp Cloud API. META_APP_SECRET verifies incoming webhook signatures
# (X-Hub-Signature-256) and signs the Embedded Signup OAuth code exchange.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is a value you choose and paste into the Meta
# App dashboard's webhook subscription config — it's app-level, not
# per-organization, since Meta calls one shared webhook URL for every
# connected org. Per-organization WhatsApp credentials (phone number ID,
# WABA ID, access token) are captured automatically by Embedded Signup, or
# entered manually by each org's admin through the Integrations page.
META_APP_SECRET=
META_GRAPH_API_URL=https://graph.facebook.com
META_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Embedded Signup ("Continue with Meta" connect button). Requires a
# Meta App (Business type) with the "Facebook Login for Business" product
# added and an Embedded Signup configuration created in the App Dashboard —
# that configuration's ID is WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID. META_APP_ID
# is the App's own ID (public — safe to ship to the frontend). Leave both
# blank to fall back to manual credential entry only.
META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Gmail email integration ("Continue with Google" connect button). Requires
# a Google Cloud project with the Gmail API enabled and an OAuth 2.0 Client
# ID (type "Web application") — see WHATSAPP_META_SETUP.md's sibling guide
# for email setup. Per-organization Gmail credentials (access + refresh
# token) are captured automatically by the OAuth flow; there is no manual
# entry fallback for email. Leave both blank to hide the connect button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
